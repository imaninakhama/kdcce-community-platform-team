SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# Leave DATABASE_URL unset to use the default local sqlite file at
# backend/instance/kdcce.db (an absolute path, resolved by app/config.py
# regardless of the process's working directory). Set it to a real
# Postgres URL for a deployed environment instead, e.g.:
# DATABASE_URL=postgresql://user:pass@host:5432/kdcce
CORS_ORIGINS=http://localhost:5173
FLASK_APP=wsgi.py

# M-Pesa (Daraja) sandbox — required to make a real STK push work for the
# public donation form's M-Pesa option (donations POST with
# payment_method: "M-Pesa"). Without these, that specific option returns
# a 502 with a clear "M-Pesa is not configured" message; every other
# donation type/method is unaffected.
#
# 1. Create an app at https://developer.safaricom.co.ke (free) and copy
#    its Consumer Key/Secret below.
# 2. MPESA_SHORTCODE/MPESA_PASSKEY already default to Safaricom's shared
#    sandbox test values (174379 / the standard published passkey) — only
#    override these if you were issued your own sandbox shortcode.
# 3. MPESA_CALLBACK_URL must be a URL Safaricom's servers can reach over
#    the public internet — localhost never works. Run a tunnel (e.g.
#    `ngrok http 5000`) and point this at <that-url>/api/mpesa/callback.
# 4. Sandbox only accepts a handful of test phone numbers, e.g.
#    254708374149 — see Safaricom's docs for the current list.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-ngrok-subdomain.ngrok-free.app/api/mpesa/callback
