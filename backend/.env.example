SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# Leave DATABASE_URL unset to use the default local sqlite file at
# backend/instance/kdcce.db (an absolute path, resolved by app/config.py
# regardless of the process's working directory). Set it to a real
# Postgres URL for a deployed environment instead, e.g.:
# DATABASE_URL=postgresql://user:pass@host:5432/kdcce
CORS_ORIGINS=http://localhost:5173
FLASK_APP=wsgi.py
# The frontend's own address — used to build the link sent in the
# volunteer-approval email. Defaults to the local dev server.
FRONTEND_URL=http://localhost:5173

# Outgoing email — powers the volunteer registration/approval/rejection
# emails (app/email/service.py, app/volunteers/service.py). Leave both
# RESEND_API_KEY and SMTP_HOST unset for local dev: emails are logged
# instead of sent, so nothing breaks without a real provider configured.
#
# Resend (https://resend.com) is tried first if RESEND_API_KEY is set —
# create a free account, copy an API key from the dashboard, and set it
# below. MAIL_FROM_ADDRESS's domain must be verified in that Resend
# account (Resend rejects sends from an unverified domain); for quick
# testing without verifying a domain, Resend's own onboarding@resend.dev
# sender works but only delivers to the email the Resend account itself
# is registered under.
RESEND_API_KEY=
# Any other provider's SMTP relay — only used if RESEND_API_KEY is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM_NAME=KDCCE
MAIL_FROM_ADDRESS=no-reply@kdcce.org

# M-Pesa (Daraja) sandbox — required to make a real STK push work for the
# public donation form's M-Pesa option (donations POST with
# payment_method: "M-Pesa"). Without these, that specific option returns
# a 502 with a clear "M-Pesa is not configured" message; every other
# donation type/method is unaffected.
#
# 1. Create an app at https://developer.safaricom.co.ke (free) and copy
#    its Consumer Key/Secret below.
# 2. MPESA_SHORTCODE/MPESA_PASSKEY already default to Safaricom's shared
#    sandbox test values (174379 / the standard published passkey) — only
#    override these if you were issued your own sandbox shortcode.
# 3. MPESA_CALLBACK_URL must be a URL Safaricom's servers can reach over
#    the public internet — localhost never works. Run a tunnel (e.g.
#    `ngrok http 5000`) and point this at <that-url>/api/mpesa/callback.
# 4. Sandbox only accepts a handful of test phone numbers, e.g.
#    254708374149 — see Safaricom's docs for the current list.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-ngrok-subdomain.ngrok-free.app/api/mpesa/callback
